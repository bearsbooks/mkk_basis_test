# Скопируйте файл в .env и измените значения при необходимости:
#   cp .env.example .env

# Статический API-ключ для заголовка X-API-Key.
API_KEY=dev-api-key

# Подключения docker-compose (совпадают с настройками сервисов postgres/rabbitmq).
POSTGRES_USER=mkk
POSTGRES_PASSWORD=mkk
POSTGRES_DB=mkk_payments
RABBITMQ_USER=mkk
RABBITMQ_PASSWORD=mkk

# Локальный запуск вне Docker (uvicorn/faststream напрямую).
DATABASE_URL=postgresql+asyncpg://mkk:mkk@localhost:5432/mkk_payments
RABBITMQ_URL=amqp://mkk:mkk@localhost:5672/
